# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# `.env` is git-ignored. Never commit it.
# ---------------------------------------------------------------------------

# Database connection string (PostgreSQL — Neon, Supabase, or local).
#
# If you use Neon, delete any `&channel_binding=require` parameter from the
# copied URL — Prisma cannot use it and every query will fail:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Secret used to encrypt session cookies and tokens.
#
# Generate a fresh one for every environment — never reuse the local value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me-with-a-long-random-string"

# Required when running behind a proxy/host such as Vercel or ngrok.
AUTH_TRUST_HOST=true

# Set to "1" only in production. Any other value logs you out immediately.
AUTH_DEBUG=0

# ---------------------------------------------------------------------------
# Email delivery (Gmail SMTP via app password)
#
# Optional. When unset, the app still works: sign-ups skip verification
# (users are created pre-verified) and assignment emails are silently skipped.
#
# 1. Google Account → Security → turn on 2-Step Verification
# 2. Search "App passwords" → create one named "PrivacyOps"
# 3. Copy the 16-character password (spaces are optional)
#
# EMAIL_USER must be the account the app password was issued for; Gmail
# rejects sending as any other address.
# ---------------------------------------------------------------------------
EMAIL_USER="you@gmail.com"
EMAIL_APP_PASSWORD="abcd efgh ijkl mnop"
EMAIL_FROM_NAME="PrivacyOps"
