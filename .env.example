# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# `.env` is git-ignored. Never commit it.
# ---------------------------------------------------------------------------

# Database connection string (PostgreSQL — Neon, Supabase, or local).
#
# If you use Neon, delete any `&channel_binding=require` parameter from the
# copied URL — Prisma cannot use it and every query will fail:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Secret used to encrypt session cookies and tokens.
#
# Generate a fresh one for every environment — never reuse the local value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me-with-a-long-random-string"

# Required when running behind a proxy/host such as Vercel or ngrok.
AUTH_TRUST_HOST=true

# Set to "1" only in production. Any other value logs you out immediately.
AUTH_DEBUG=0

# ---------------------------------------------------------------------------
# Email verification (Brevo)
#
# Sign-ups are disabled until these are set, because nobody can complete an
# account without receiving a code.
#
# 1. Create a free account at https://app.brevo.com
# 2. Senders → Add a sender → enter an address you own → click its verify link
# 3. SMTP & API → API Keys → Generate → copy the key
# ---------------------------------------------------------------------------
BREVO_API_KEY="xkeysib-..."
BREVO_SENDER_EMAIL="you@example.com"
BREVO_SENDER_NAME="PrivacyOps"
