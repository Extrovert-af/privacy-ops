# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# `.env` is git-ignored. Never commit it.
# ---------------------------------------------------------------------------

# Database connection string.
#
# Local development (default) — SQLite file next to the schema:
DATABASE_URL="file:./dev.db"
#
# Production (Vercel + a hosted Postgres, e.g. Neon or Supabase). Replace
# USER / PASSWORD / HOST / DBPASSWORD with the values your provider gives you:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
#
# NOTE: switching between SQLite and Postgres also requires changing the
# `provider` in prisma/schema.prisma. See README.md.

# Secret used to encrypt session cookies and tokens.
#
# Generate a fresh one for every environment — never reuse the local value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me-with-a-long-random-string"

# Required when running behind a proxy/host such as Vercel or ngrok.
AUTH_TRUST_HOST=true

# Set to "1" only in production. Any other value logs you out immediately.
AUTH_DEBUG=0
